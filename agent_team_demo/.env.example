# OpenAI API Key - Required for AI features
# Replace with your actual API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GitHub Access Token - Optional, needed for GitHub scanning features
# Generate one at https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=

# Model Configuration
OPENAI_MODEL=gpt-4-turbo-preview

# Security Scanner Settings
MAX_THREADS=4
MAX_SCAN_DEPTH=3
REQUEST_TIMEOUT=10

# Agno Configuration for Agent Features
AGNO_OPENAI_API_KEY=${OPENAI_API_KEY}
AGNO_LOG_LEVEL=INFO 